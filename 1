import sqlite3

conn = sqlite3.connect('Animal_Kingdom.db')
cursor = conn.cursor()

cursor.execute('''
CREATE TABLE IF NOT EXISTS Animals (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Назва_звіра TEXT,
    Тип_звіра TEXT
)
''')
conn.commit()
animals_to_insert = [
    ("Лев", "Ссавець"),
    ("Крокодил", "Плазун"),
    ("Орел", "Птах"),
    ("Морська черепаха", "Плазун"),
    ("Мавпа", "Ссавець")
]
cursor.executemany("INSERT INTO Animals (Назва_звіра, Тип_звіра) VALUES (?, ?)", animals_to_insert)
conn.commit()
print("Звірі типу 'Ссавець':")
cursor.execute("SELECT Назва_звіра, Тип_звіра FROM Animals WHERE Тип_звіра = 'Ссавець'")
mammals = cursor.fetchall()
for row in mammals:
    print(row)
    print("\nВсі записи про звірів:")
    cursor.execute("SELECT * FROM Animals")
    all_animals = cursor.fetchall()
    for row in all_animals:
        print(row)

    conn.close()
